# LiveKit — browser-based live streaming (creator goes live from the browser,
# viewers watch over WebRTC). Create a project at https://cloud.livekit.io and
# copy the project URL + API key/secret from Settings → Keys into .env.local.
# Also add a webhook under Settings → Webhooks pointing at
# <your-app>/api/livekit/webhook — it fires room_finished so a show ends the
# moment its room empties, instead of lingering `live` until the stale sweep.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Design mode. Runs the studio and watch pages against a local fake of the
# LiveKit transport: real screen share and camera, but no room is joined, so no
# LiveKit or Mux usage is billed. Chat, polls, votes and reactions run over a
# BroadcastChannel, so a /host tab and a /s/<slug> tab talk to each other.
# Use `npm run dev:design` rather than setting this by hand — it must never be
# on in a deployed environment. See src/lib/live/mode.ts.
# NEXT_PUBLIC_LOCAL_STREAM=1
# Baseline fake viewer count (default 42).
# NEXT_PUBLIC_LOCAL_STREAM_VIEWERS=42

# Mux API credentials. Required for the show lifecycle — archives LiveKit egress
# to on-demand replay at /s/<slug>. LiveKit carries the live WebRTC path.
# Create an access token in the Mux dashboard: Settings → Access Tokens.
# Give it "Mux Video" read/write permissions. Copy the values into .env.local.
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
# Signing secret from Mux dashboard → Settings → Webhooks (one per endpoint).
# Point the webhook at https://<your-app>/api/mux/webhook and subscribe to
# video.asset.ready and video.asset.track.ready so replays backfill without polling.
MUX_WEBHOOK_SECRET=

# Neon Postgres connection string.
# Get it from the Neon dashboard: Project → Connection Details → "Connection string".
# Use the POOLED connection string (host contains "-pooler") for serverless apps.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.us-east-2.aws.neon.tech/dbname?sslmode=require"

# Clerk authentication.
# From the Clerk dashboard (API Keys), or auto-provisioned by the Vercel
# Marketplace integration (`vercel integration add clerk`).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxx
CLERK_SECRET_KEY=sk_test_xxxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Channel3 — resolves a retailer product URL to a catalog entry with a
# trackable buy link. Get a key at https://trychannel3.com/developers.
# Server-only: never expose this as NEXT_PUBLIC_.
CHANNEL3_API_KEY=

# Comma-separated email addresses allowed to force-end live shows at /admin.
ADMIN_ALLOWLIST=

# Optional comma-separated Clerk usernames with permanent super-admin access
# at /admin (in addition to built-in super admins in code).
SUPER_ADMIN_USERNAMES=

# Optional comma-separated Clerk user ids hidden from the homepage and metrics.
# DISCOVERY_EXCLUDED_HOST_IDS=
# DISCOVERY_EXCLUDED_HOST_NAMES=
# DISCOVERY_EXCLUDED_EMAILS=
# DISCOVERY_EXCLUDED_USERNAMES=
# METRICS_EXCLUDED_HOST_IDS=

# Bearer token for Vercel Cron → GET /api/cron/end-stale-shows
CRON_SECRET=

# Resend — pre-show reminder emails for scheduled shows (optional locally).
# Get an API key at https://resend.com and verify your sending domain.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Frontrow <notifications@yourdomain.com>

# --- Creator outreach (/admin/creator-outreach) ---------------------------

# RapidAPI key for the `tiktok-api23` proxy, used to search public TikTok
# accounts by keyword. Subscribe at
# https://rapidapi.com/Lundehund/api/tiktok-api23 and copy the key.
# Server-only: never expose this as NEXT_PUBLIC_.
RAPIDAPI_KEY=

# Vercel AI Gateway, used to write outreach drafts with Claude. Only needed for
# local dev — deployments on Vercel authenticate over OIDC automatically.
# Create one at https://vercel.com/dashboard/ai-gateway.
AI_GATEWAY_API_KEY=

# No email provider is needed: drafts open in the admin's own Gmail compose
# window and are sent by hand, so there's no sending domain to verify.

# Optional error tracking in production (https://sentry.io)
SENTRY_DSN=
