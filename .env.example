# Mux API credentials.
# Create an access token in the Mux dashboard: Settings → Access Tokens.
# Give it "Mux Video" read/write permissions. Copy the values into .env.local.
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=

# Neon Postgres connection string.
# Get it from the Neon dashboard: Project → Connection Details → "Connection string".
# Use the POOLED connection string (host contains "-pooler") for serverless apps.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.us-east-2.aws.neon.tech/dbname?sslmode=require"
